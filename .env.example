# Local credentials and environment overrides. Never commit this file.
# Copy to .env and fill in values.

# AWS Bedrock (LLM provider)
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your-token-here
LLM_PROVIDER=bedrock-haiku

# Database
DATABASE_URL=postgresql+psycopg://sme:sme@db:5432/sme_copilot

# KYC stub
KYC_STUB_RESULT=pass

# Upload limits
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_APP=5